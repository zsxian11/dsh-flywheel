{
  "name": "@dsh-flywheel/lexical-sqlite",
  "version": "0.1.0",
  "description": "v1 LexicalIndex + GraphStore: SQLite FTS5 body index and edges table over .dsh/flywheel/index.sqlite (node:sqlite, WAL).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
