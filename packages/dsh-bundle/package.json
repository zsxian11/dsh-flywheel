{
  "name": "@dsh-flywheel/dsh-bundle",
  "version": "0.1.0",
  "description": "Flywheel DSH bundle: Host plugins (store / lexical-sqlite / inject / index / window / tools) plus the Web settings card client half.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./store": {
      "types": "./lib/types/store.d.ts",
      "default": "./lib/store.js"
    },
    "./lexical-sqlite": {
      "types": "./lib/types/lexical-sqlite.d.ts",
      "default": "./lib/lexical-sqlite.js"
    },
    "./inject": {
      "types": "./lib/types/inject.d.ts",
      "default": "./lib/inject.js"
    },
    "./index": {
      "types": "./lib/types/indexer.d.ts",
      "default": "./lib/indexer.js"
    },
    "./window": {
      "types": "./lib/types/window.d.ts",
      "default": "./lib/window.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dsh-flywheel/core": "link:../core",
    "@dsh-flywheel/lexical-sqlite": "link:../lexical-sqlite"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-session-title": "*",
    "@deepseek-ai/dsh-timeout": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-session-title": { "optional": true },
    "@deepseek-ai/dsh-timeout": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "license": "MIT"
}
